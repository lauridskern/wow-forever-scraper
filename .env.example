# Nothing is required. Everything below is optional.

# ── Wowhead ─────────────────────────────────────────────
# Site section to scrape: wowhead.com/<env>/...
WOWHEAD_ENV=forever

# ── Cloudflare relay (see worker/relay.js) ──────────────
# Set these to route www.wowhead.com page fetches through your worker.
# Leave empty to fetch directly (fine from a home IP; datacenter IPs get throttled).
# WOWHEAD_WORKER_URL=
# WOWHEAD_WORKER_KEY=

# ── AWS WAF token (entity pages) ────────────────────────
# Where the minted aws-waf-token cookie is cached. Empty -> ~/.wowhead-token.
# WOWHEAD_TOKEN_FILE=
# Chromium used to mint the cookie. Empty -> auto-detect (PATH, then Playwright).
# WOWHEAD_CHROME_PATH=
# WOWHEAD_TOKEN_MAX_AGE_HOURS=72
# MINT_DEADLINE_MS=45000
# MINT_FAILURE_BACKOFF_MS=600000

# ── Tuning ──────────────────────────────────────────────
# LOG_LEVEL=info
# CACHE_TTL_SECONDS=3600
